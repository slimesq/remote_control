   <string notr="true">QMainWindow {
    background: #f4f1ea;
}
QGroupBox {
    border: 1px solid #c9c0af;
    border-radius: 10px;
    margin-top: 10px;
    background: #fbf8f2;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px 0 6px;
    color: #5e5033;
}
QPushButton {
    min-height: 34px;
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid #b89a63;
    background: #d8b26e;
    color: #2d2418;
}
QPushButton:hover {
    background: #e3bf7d;
}
QPushButton:pressed {
    background: #c79f57;
}
QPushButton:disabled {
    background: #dccfb4;
    border: 1px solid #c9bea8;
    color: #8e8472;
}
QLineEdit, QSpinBox, QTreeWidget, QTableWidget {
    border: 1px solid #cfc6b6;
    border-radius: 8px;
    background: white;
    padding: 4px;
}
QTreeWidget:disabled, QTableWidget:disabled, QLineEdit:disabled, QSpinBox:disabled {
    background: #f0ebe2;
    color: #8e8472;
}
QTreeWidget, QTableWidget {
    alternate-background-color: #f7f2e8;
}
QHeaderView::section {
    background: #eadfc8;
    color: #4d4029;
    border: none;
    border-right: 1px solid #d6c8ae;
    border-bottom: 1px solid #d6c8ae;
    padding: 6px 8px;
    font-weight: 600;
}
QStatusBar {
    background: #efe7d7;
}</string>
